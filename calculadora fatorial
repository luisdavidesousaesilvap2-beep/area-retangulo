while True:
    
    numero = int(input("Digite um número inteiro positivo (ou 0 para sair): "))
    
    if numero == 0:
        print("Programa finalizado.")
        break
        
    if numero < 0:
        print("Por favor, digite apenas números positivos.\n")
        continue
    
    fatorial = 1
    for i in range(1, numero + 1):
        fatorial *= i
        
    print(f"O fatorial de {numero} é {fatorial}\n")
